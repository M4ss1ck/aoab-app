# Anything here is excluded from the build context. The context was shipping
# ~70MB of things the build cannot use, which costs upload time on every deploy
# and busts the COPY layer whenever any of it changes.

# Installed inside the image; copying the host tree in would clobber it.
node_modules

# Build output, regenerated by `pnpm build`.
dist
.astro

# Asset pipeline machine-local state: model weights venv and its content cache.
# `pnpm build` does not run the pipeline, so neither is reachable from a build.
.venv-assets
.cache

# Tests do not run in the image.
tests
test-results
playwright-report
playwright.config.ts
vitest.config.ts

# History, editor and OS noise.
.git
.gitignore
.github
.idea
.vscode
.DS_Store
docs

# Secrets must never enter an image layer.
.env
.env.*
