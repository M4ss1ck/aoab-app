# Where an artist can reach a human about their work.
#
# Optional. Unset, the closing credits and the fallback gallery simply omit the
# takedown sentence, which is better than printing a placeholder address.
#
# The site is static output, so this is read when the site is BUILT, not when it
# is served. In Coolify it belongs in Build Variables; as a docker build it is
# --build-arg CONTACT_EMAIL=you@example.org. Changing it means rebuilding.
CONTACT_EMAIL=
