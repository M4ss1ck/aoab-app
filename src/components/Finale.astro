---
import { Image } from 'astro:assets';
import type { Scene } from '../lib/scenes';
import { CONTACT_EMAIL, SOURCE_WORK } from '../lib/site';
import { creditSummary, untracedSentence } from '../lib/ordering';

interface Props {
  scenes: Scene[];
  title: string;
  hero: { id: string; title: string; credit: Scene['credit'] };
}

const { scenes, title, hero } = Astro.props;

const generated = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/generated/*.webp',
  { eager: true },
);

/**
 * The ending.
 *
 * An endless loop has no payoff, so the sequence resolves here: the ten pieces
 * reassemble as a single wall, the wordmark returns at full size, and the
 * credits get a real surface instead of a footnote.
 *
 * Built in the DOM rather than on the canvas on purpose. The credits are text
 * that wants to be selectable, linkable and readable by a screen reader, and
 * the thumbnails are small enough that DOM compositing is not the bottleneck.
 */
const tiles = scenes.map((scene) => ({
  scene,
  image: generated[`/src/assets/generated/${scene.id}.webp`]?.default,
}));

// Every piece is listed, traced or not. Filtering to the credited ones would
// make a half-traced gallery look fully credited, which is the failure this
// panel exists to prevent.
// The hero opens the experience and belongs in the credits with everything
// else, even though it is not a gallery scene.
const credited = [{ title: hero.title, credit: hero.credit }, ...scenes];
const { untraced, total, labelPerItem } = creditSummary(credited);
const gap = untracedSentence(untraced, total);
---

<section class="finale" data-finale hidden aria-label="The complete gallery">
  <!-- The centring lives on this wrapper, not on the scroll container. A
       scroll container that centres its own overflowing content makes the top
       of that content unreachable; `min-block-size: 100%` plus centre-justify
       centres while it fits and falls back to top-aligned once it does not. -->
  <div class="finale__inner">
    <div class="finale__wall" data-finale-wall aria-hidden="true">
      {
        tiles.map(({ scene, image }, index) => (
          <button
            class="finale__tile"
            type="button"
            data-finale-tile
            data-index={index}
            style={`--accent: ${scene.palette[0]}`}
            aria-label={`Return to ${scene.title}`}
            tabindex="-1"
          >
            {image && (
              <Image
                src={image}
                width={420}
                densities={[1, 2]}
                format="webp"
                quality={78}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="finale__tile-label">{scene.title}</span>
          </button>
        ))
      }
    </div>

    <div class="finale__panel">
      <p class="finale__eyebrow">The end of the sequence</p>
      <h2 class="finale__title">{title}</h2>

      <div class="finale__actions">
        <button class="finale__button" type="button" data-finale-replay>
          Watch it again
        </button>
        <button class="finale__button finale__button--quiet" type="button" data-finale-back>
          Back to the last piece
        </button>
      </div>

      <div class="finale__credits">
        <h3 class="finale__credits-heading">Artwork</h3>
        <ul class="finale__credits-list">
          {credited.map((scene) => (
            <li>
              <span class="finale__credits-piece">{scene.title}</span>
              {scene.credit?.artist ? (
                scene.credit.url ? (
                  <a href={scene.credit.url} rel="noopener noreferrer" target="_blank">
                    {scene.credit.artist}
                  </a>
                ) : (
                  <span>{scene.credit.artist}</span>
                )
              ) : (
                <>
                  {labelPerItem && <span class="finale__credits-unknown">Artist untraced</span>}
                  {/* No name, but we can still show the trail we followed. */}
                  {scene.credit?.url && (
                    <a href={scene.credit.url} rel="noopener noreferrer" target="_blank">
                      Source
                    </a>
                  )}
                </>
              )}
              {scene.credit?.license && (
                <span class="finale__credits-licence">{scene.credit.license}</span>
              )}
            </li>
          ))}
        </ul>

        <p class="finale__credits-note">
          Fan artwork for <em>{SOURCE_WORK.title}</em>, reproduced here out of admiration for it.
          The series is {SOURCE_WORK.author}’s, illustrated by {SOURCE_WORK.illustrator} and
          published by {SOURCE_WORK.publisher}; this site is not affiliated with any of them. Each
          piece belongs to whoever drew it.
          {gap && (
            <>
              {' '}
              {gap} If one of them is yours, or you know who made it, we want to credit you
              properly.
            </>
          )}
          {CONTACT_EMAIL && (
            <>
              {' '}
              To be credited differently, or taken down, write to{' '}
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
            </>
          )}
        </p>
      </div>
    </div>
  </div>
</section>
